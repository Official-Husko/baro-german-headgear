<?xml version="1.0" encoding="utf-8"?>
<Items>
    <Item name="MP40" identifier="oh_mp40" category="Weapon" maxstacksize="1"
        maxstacksizecharacterinventory="1" interactthroughwalls="true"
        tags="weapon,gun,smg,oh_mp40,handheld" Scale="0.38" impactsoundtag="impact_metal_heavy">
        <!-- visuals -->
        <InventoryIcon texture="%ModDir%/textures/weapons/smg_atlas.png" sourcerect="14,31,262,95"
            origin="0.5,0.5" />
        <Sprite texture="%ModDir%/textures/weapons/smg_atlas.png" sourcerect="14,31,262,95"
            depth="0.55" origin="0.5,0.5" />
        <Body width="96" height="24" density="18" />
        <!-- holdable: two-handed -->
        <Holdable slots="Any,RightHand+LeftHand" controlpose="true" holdpos="40,-10" aimpos="38,-10"
            handle1="-45,-7" handle2="50,15" holdangle="-35" msg="ItemMsgPickUpSelect" />
        <!-- the gun holds exactly 1 magazine item in its internal slot -->
        <ItemContainer capacity="1" maxstacksize="1" hideitems="false"
            containedstateindicatorslot="0" containedstateindicatorstyle="bullet"
            containedspritedepth="0.56" allowstoring="true" allowtaking="true" drawinventory="true"
            canbeselected="true">
            <Containable items="oh_mag_mp40_9x19mm" hide="false" itempos="16.8,-6" rotation="0" />
            <SlotIcon slotindex="0" texture="Content/UI/StatusMonitorUI.png" sourcerect="256,448,64,64" origin="0.5,0.5" />
            <SlotIcon slotindex="1" texture="Content/UI/StatusMonitorUI.png" sourcerect="320,448,64,64" origin="0.5,0.5" />
        </ItemContainer>

        <RangedWeapon barrelpos="130,35" cursorpos="100,-18" reload="0.12" firerate="8.0"
            holdtrigger="true" spread="6.0" unskilledspread="14.0" recoil="1.8"
            projectilevelocity="700" suitableammocontainertags="magazine,9mm"
            ammoidentifier="oh_ammo_9x19_fmj">
            <ParticleEmitter particle="muzzleflash" particleamount="1" velocitymin="0"
                velocitymax="0" type="OnUse" />
            <StatusEffect type="OnUse" target="This">
                <ParticleEmitter particle="casingfirearm" particleamount="1" anglemin="90"
                    anglemax="150" velocitymin="50" velocitymax="250" CopyEntityAngle="true" />
                <Explosion range="150.0" force="1" shockwave="false" smoke="false" flames="false"
                    sparks="false" underwaterbubble="false" camerashake="3.0" />
            </StatusEffect>
            <StatusEffect type="OnUse" target="Contained">
                <Use />
            </StatusEffect>
            <RequiredItems identifier="oh_ammo_9x19_fmj" type="Contained" msg="ItemMsgAmmoRequired" />
            <RequiredSkill identifier="weapons" level="50" />
            
            <!-- UI crosshair (optional, tweak textures) -->
            <Crosshair texture="Content/Items/Weapons/Crosshairs.png" sourcerect="0,256,256,256" />
            <CrosshairPointer texture="Content/Items/Weapons/Crosshairs.png" sourcerect="256,256,256,256" />
            
            <!-- sounds -->
            <Sound file="%ModDir%/sounds/weapons/mp40/oh_mp40_s1.ogg" type="OnUse" range="3000"
                selectionmode="Random" />
            <Sound file="%ModDir%/sounds/weapons/mp40/oh_mp40_s2.ogg" type="OnUse" range="3000" />
            <Sound file="%ModDir%/sounds/weapons/mp40/oh_mp40_s3.ogg" type="OnUse" range="3000" />
            <Sound file="%ModDir%/sounds/weapons/mp40/oh_mp40_s4.ogg" type="OnUse" range="3000" />
            <Sound file="%ModDir%/sounds/weapons/mp40/oh_mp40_s5.ogg" type="OnUse" range="3000" />
            <Sound file="%ModDir%/sounds/weapons/mp40/oh_mp40_s6.ogg" type="OnUse" range="3000" />
            <Sound file="%ModDir%/sounds/weapons/mp40/oh_mp40_s7.ogg" type="OnUse" range="3000" />
        </RangedWeapon>
        <!-- crafting / deconstruct -->
        <Fabricate suitablefabricators="fabricator" requiredtime="60" requiresrecipe="true"
            amount="1">
            <RequiredSkill identifier="weapons" level="45" />
            <RequiredItem identifier="steel" amount="4" />
            <RequiredItem identifier="aluminium" amount="1" />
        </Fabricate>
        <Deconstruct time="20">
            <Item identifier="steel" amount="3" />
            <Item identifier="aluminium" amount="1" />
        </Deconstruct>
        
        <Price baseprice="520" sold="true">
            <Price storeidentifier="merchantcity" sold="false" />
            <Price storeidentifier="merchantoutpost" sold="false" />
            <Price storeidentifier="merchantmilitary" multiplier="1.05" />
            <Price storeidentifier="merchantarmory" multiplier="1.00" />
            <Price storeidentifier="merchantresearch" sold="false" />
            <Price storeidentifier="merchantmine" sold="false" />
        </Price>
    </Item>
</Items>