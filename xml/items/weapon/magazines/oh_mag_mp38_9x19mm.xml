<?xml version="1.0" encoding="utf-8"?>
<Items>
    <Item name="MP38 Magazine (9×19mm)" identifier="oh_mag_mp38_9x19mm" category="Weapon"
        maxstacksize="1" maxstacksizecharacterinventory="1" interactthroughwalls="true"
        cargocontaineridentifier="metalcrate"
        tags="magazine,mp38,9mm,handheldammo,smallitem,oh_mp38mag" Scale="0.38"
        impactsoundtag="impact_metal_heavy">
        <!-- spawn rules (tweak to taste) -->
        <PreferredContainer primary="armcab" amount="1" spawnprobability="1" notcampaign="true"
            notpvp="true" />
        <PreferredContainer secondary="outpostsecarmcab" minamount="1" maxamount="2"
            spawnprobability="0.5" />
        <PreferredContainer secondary="secarmcab" />
        <!-- craft (can be a hair cheaper / earlier than MP40 mag if you like) -->
        <Fabricate suitablefabricators="fabricator" requiredtime="28" requiresrecipe="true"
            amount="1">
            <RequiredSkill identifier="weapons" level="28" />
            <RequiredItem identifier="steel" amount="3" />
        </Fabricate>
        <!-- visuals: point to your atlas; update sourcerect if you have a distinct MP38 mag sprite -->
        <InventoryIcon texture="%ModDir%/textures/weapons/smg_atlas.png" sourcerect="206,100,13,56"
            origin="0.5,0.5" />
        <Sprite texture="%ModDir%/textures/weapons/smg_atlas.png" depth="0.54"
            sourcerect="206,100,13,56" origin="0.5,0.5" />
        <Body width="36" height="12" density="15" />
        <Pickable slots="Any" msg="ItemMsgPickUpSelect" />
        <Holdable canBeCombined="true" slots="Any,RightHand,LeftHand" handle1="0,0"
            msg="ItemMsgPickUpSelect" />
        <!-- CONTAINER: one slot that stacks up to 32 rounds (clean UI), interactive for load/unload -->
        <ItemContainer capacity="1" maxstacksize="32" hidecontents="true" allowstoring="true"
            allowtaking="true" drawinventory="true" canbeselected="true"
            removecontaineditemsondeconstruct="true">
            <Containable items="oh_ammo_9x19_fmj" />
            <SlotIcon slotindex="0" texture="Content/UI/StatusMonitorUI.png"
                sourcerect="256,448,64,64" origin="0.5,0.5" />
            <SlotIcon slotindex="1" texture="Content/UI/StatusMonitorUI.png"
                sourcerect="320,448,64,64" origin="0.5,0.5" />
        </ItemContainer>
        <Deconstruct time="10">
            <Item identifier="steel" amount="2" />
        </Deconstruct>
        <Price baseprice="110" sold="true">
            <Price storeidentifier="merchantcity" sold="false" />
            <Price storeidentifier="merchantoutpost" multiplier="1.0" />
            <Price storeidentifier="merchantmilitary" multiplier="1.45" />
            <Price storeidentifier="merchantarmory" multiplier="1.45" />
            <Price storeidentifier="merchantresearch" sold="false" />
            <Price storeidentifier="merchantmine" sold="false" />
        </Price>
    </Item>
</Items>