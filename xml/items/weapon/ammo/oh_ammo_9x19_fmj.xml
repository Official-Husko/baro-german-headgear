<?xml version="1.0" encoding="utf-8"?>
<Items>
    <Item identifier="oh_ammo_9x19_fmj" name="9×19mm FMJ Round" category="Weapon" maxstacksize="32"
        maxstacksizecharacterinventory="32" interactthroughwalls="true"
        cargocontaineridentifier="metalcrate" tags="smallitem,9mm,handheldammo,ammoround,oh_9mm"
        scale="0.05" impactsoundtag="impact_metal_light">
        <!-- spawn preferences (optional) -->
        <PreferredContainer primary="oh_mag_mp40_9x19mm" amount="32" spawnprobability="1" />
        <PreferredContainer primary="armcab" minamount="8" maxamount="24" spawnprobability="1"
            notcampaign="true" notpvp="true" />
        <PreferredContainer secondary="outpostsecarmcab" minamount="4" maxamount="16"
            spawnprobability="0.6" />
        <PreferredContainer secondary="secarmcab" />
        <!-- visuals (replace textures with your assets) -->
        <InventoryIcon texture="%ModDir%/textures/weapons/ammo_atlas1.png"
            sourcerect="7,7,58,57" origin="0.5,0.5" />
        <Sprite texture="%ModDir%/textures/weapons/ammo_atlas1.png" sourcerect="7,7,58,57"
            depth="0.55" origin="0.5,0.5" />
        <Body width="12" height="6" density="15" />
        <Pickable slots="Any" msg="ItemMsgPickUpSelect" />
        <!-- hitscan projectile (recommended for bullets) -->
        <Projectile characterusable="false" hitscan="true" removeonhit="true" range="1200"
            penetration="0.12" spread="0">
            <ParticleEmitter particle="tracerfirearm" particleamount="1" velocitymin="0"
                velocitymax="0" colormultiplier="255,255,115,100" scalemultiplier="1,0.5" />
            <Attack structuredamage="1" itemdamage="1" targetforce="2">
                <Affliction identifier="gunshotwound" strength="16" />
                <Affliction identifier="bleeding" strength="10" />
                <Affliction identifier="stun" strength="0.05" />
            </Attack>
            <StatusEffect type="OnImpact" target="UseTarget">
                <ParticleEmitter particle="impactfirearm" particleamount="1" velocitymin="0"
                    velocitymax="0" />
            </StatusEffect>
            <StatusEffect type="OnImpact" target="UseTarget">
                <Conditional entitytype="eq Structure" />
                <Conditional hastag="eq door" />
                <ParticleEmitter particle="spark" copyentityangle="true" anglemin="-10"
                    anglemax="10" particleamount="3" velocitymin="-10" velocitymax="-200"
                    scalemin="0.5" scalemax="1" />
            </StatusEffect>
        </Projectile>
        <!-- optional: cheaper to craft than mags (you said bullets cheap) -->
        <Fabricate suitablefabricators="fabricator" requiredtime="8" requiresrecipe="true"
            amount="8">
            <RequiredSkill identifier="weapons" level="15" />
            <RequiredItem identifier="steel" amount="1" />
        </Fabricate>
        <Price baseprice="8" sold="true">
            <Price storeidentifier="merchantcity" sold="false" />
            <Price storeidentifier="merchantoutpost" multiplier="1.0" />
            <Price storeidentifier="merchantmilitary" multiplier="1.5" />
            <Price storeidentifier="merchantarmory" multiplier="1.5" />
            <Price storeidentifier="merchantresearch" sold="false" />
            <Price storeidentifier="merchantmine" sold="false" />
        </Price>
    </Item>
</Items>